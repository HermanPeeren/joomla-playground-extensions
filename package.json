{
  "name": "joomla-playground",
  "private": true,
  "description": "Joomla running in the browser via PHP-in-WebAssembly, comparable to WordPress Playground",
  "license": "GPL-2.0-or-later",
  "type": "module",
  "scripts": {
    "docs:pdf": "node scripts/build-docs.mjs",
    "wasm:serve": "node wasm/serve.mjs",
    "wasm:cli": "node wasm/cli.mjs",
    "bundle": "php bin/build-browser-bundles.php",
    "web:dev": "vite --config web/vite.config.js",
    "web:build": "vite build --config web/vite.config.js",
    "web:preview": "vite preview --config web/vite.config.js --port 5401",
    "test:browser": "node --test --test-timeout=600000 tests/browser/playground.test.mjs",
    "test:mcp": "npm test --prefix mcp",
    "test:site-api": "node --test --test-timeout=300000 tests/site-api/site-api.test.mjs",
    "test:proxy": "node --test tests/proxy/cors-proxy.test.mjs",
    "test:zip": "node --test tests/zip/zip-ranges.test.mjs",
    "proxy:dev": "node proxy/dev-server.mjs",
    "test:scripts": "node --test tests/scripts/update-joomla-versions.test.mjs",
    "joomla:versions": "node scripts/update-joomla-versions.mjs",
    "demos": "node scripts/build-demos.mjs"
  },
  "devDependencies": {
    "@codemirror/commands": "6.11.1",
    "@codemirror/lang-css": "6.3.1",
    "@codemirror/lang-html": "6.4.12",
    "@codemirror/lang-javascript": "6.2.5",
    "@codemirror/lang-json": "6.0.2",
    "@codemirror/lang-php": "6.0.2",
    "@codemirror/lang-sql": "6.10.0",
    "@codemirror/lang-xml": "6.1.0",
    "@codemirror/language": "6.13.1",
    "@codemirror/legacy-modes": "6.5.5",
    "@codemirror/merge": "6.12.3",
    "@codemirror/state": "6.7.6",
    "@codemirror/theme-one-dark": "6.1.3",
    "@codemirror/view": "6.43.15",
    "@php-wasm/fs-journal": "3.1.66",
    "@php-wasm/node": "3.1.66",
    "@php-wasm/util": "3.1.66",
    "@php-wasm/universal": "3.1.66",
    "@php-wasm/web": "3.1.66",
    "codemirror": "6.0.2",
    "marked": "18.1.1",
    "playwright-core": "1.64.1",
    "vite": "6.4.5"
  }
}
